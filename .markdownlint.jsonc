{
  // Lenient baseline for an existing, spec-heavy repo. CI lints only the markdown files changed
  // in a PR (see .github/workflows/quality.yml), so new/edited docs are held to this bar without
  // forcing a one-time cleanup of 700+ existing files. Tighten rules over time.
  "default": true,
  "MD013": false, // line length — specs and tables run long
  "MD033": false, // inline HTML — used intentionally in some specs
  "MD041": false, // first line must be a heading — files lead with --- frontmatter
  "MD024": { "siblings_only": true }, // duplicate headings ok unless siblings
  "MD026": false, // trailing punctuation in headings
  "MD029": false, // ordered list item prefix
  "MD034": false, // bare URLs
  "MD036": false, // emphasis used instead of a heading
  "MD040": false, // language hint on fenced code
  "MD012": false, // multiple consecutive blank lines
  "MD007": false // unordered list indentation
}
